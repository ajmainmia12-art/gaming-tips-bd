<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>All Video BD - Final</title>
<style>
body{margin:0;background:#0a0a0a;color:#fff;font-family:system-ui}
#header{position:sticky;top:0;background:#000;padding:12px;border-bottom:2px solid #00c853;z-index:10}
#q{width:75%;background:#1a1a1a;color:#fff;border:1px solid #333;padding:12px 16px;border-radius:25px;outline:none}
#btn{width:20%;background:#00c853;color:#fff;border:none;padding:12px;border-radius:25px;margin-left:2%;font-weight:800}
.card{background:#111;margin:10px;border-radius:12px;overflow:hidden;border:1px solid #222}
</style>
</head>
<body>
<div id="header">
<div style="text-align:center;margin-bottom:8px"><b style="color:#00c853">🎬 All Video BD - Worldwide</b></div>
<div style="display:flex"><input id="q" placeholder="Natok Song Waz Movie লিখুন..." value="Bangla Natok"><button id="btn" onclick="search()">Search</button></div>
</div>
<div id="feed" style="padding:10px">Loading...</div>
<div id="player" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:#000;z-index:999;flex-direction:column"><div style="padding:10px;background:#111;display:flex;justify-content:space-between"><span>Playing</span><button onclick="document.getElementById('player').style.display='none';document.getElementById('frame').src=''" style="background:#333;color:#fff;border:none;width:30px;height:30px;border-radius:50%">X</button></div><iframe id="frame" style="flex:1;border:none" allowfullscreen></iframe></div>
<script>
async function search(){
let q=document.getElementById('q').value||'Bangla Natok';
let feed=document.getElementById('feed');
feed.innerHTML='🔍 "'+q+'" খুঁজছি...';
try{
let r=await fetch('https://pipedapi.kavin.rocks/search?q='+encodeURIComponent(q)+'&filter=videos');
let d=await r.json();
let vids=d.items||d;
feed.innerHTML=vids.slice(0,20).map(v=>{
let id=(v.url||'').split('v=')[1]||v.url?.split('/').pop()||v.id||'';
if(!id)return '';
return `<div class="card"><div onclick="play('${id}')"><img src="${v.thumbnail||'https://img.youtube.com/vi/'+id+'/mqdefault.jpg'}" style="width:100%;height:190px;object-fit:cover"><div style="padding:8px"><b>${v.title||''}</b><br><span style="color:#888;font-size:11px">${v.uploaderName||''}</span><br><button style="margin-top:6px;background:#00c853;color:#fff;border:none;padding:8px 16px;border-radius:20px;width:100%">▶ Play</button></div></div></div>`;
}).join('');
if(!feed.innerHTML)throw 'empty';
}catch(e){
let backup=[{id:'2OEL4P1Rz04',t:'Bangla Natok 2024'},{id:'dQw4w9WgXcQ',t:'Bangla Song 2024'},{id:'jNQXAC9IVRw',t:'Waz Azhari 2024'},{id:'9bZkp7q19f0',t:'Funny Video'}];
feed.innerHTML=backup.map(v=>`<div class="card"><div onclick="play('${v.id}')"><img src="https://img.youtube.com/vi/${v.id}/mqdefault.jpg" style="width:100%;height:190px"><div style="padding:8px"><b>${q} - ${v.t}</b><br><button style="margin-top:6px;background:#00c853;color:#fff;border:none;padding:8px 16px;border-radius:20px;width:100%">▶ Play</button></div></div></div>`).join('');
}
}
function play(id){document.getElementById('frame').src='https://www.youtube.com/embed/'+id+'?autoplay=1';document.getElementById('player').style.display='flex';}
search();
document.getElementById('q').addEventListener('keypress',e=>{if(e.key==='Enter')search()});
</script>
</body>
</html>
