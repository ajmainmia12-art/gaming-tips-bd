<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>নামাজী বন্ধু - সারা পৃথিবীর Video</title>
<style>
body{margin:0;background:#000;color:#fff;font-family:system-ui}
.header{background:linear-gradient(135deg,#f57224,#ff0000);padding:10px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:100}
.scroll-banner{background:linear-gradient(90deg,#f57224,#ff0000,#1877f2,#00c853);padding:8px 0;overflow:hidden;white-space:nowrap}
.scroll-text{display:inline-block;animation:scroll 20s linear infinite;color:#fff;font-weight:bold;font-size:12px}
@keyframes scroll{0%{transform:translateX(100%)}100%{transform:translateX(-100%)}}
.world-notice{background:linear-gradient(135deg,#111,#222);border:2px solid #f57224;padding:12px;border-radius:12px;margin:8px;text-align:center}
.search-box{padding:8px;background:#000;display:flex;gap:6px;position:sticky;top:48px;z-index:99}
.search-box input{flex:1;padding:10px;border-radius:20px;border:1px solid #444;background:#222;color:#fff}
.country-bar{padding:6px 8px;display:flex;gap:5px;overflow-x:auto;background:#111}
.country-btn{border:none;padding:6px 12px;border-radius:15px;font-size:10px;white-space:nowrap;color:#fff;background:#222;cursor:pointer}
.country-btn.active{background:#f57224}
.feed{padding:8px}
.video-card{background:#111;border-radius:12px;margin-bottom:12px;overflow:hidden;border:1px solid #222}
.daraz-below{background:#fff;border-radius:0 0 12px 12px;padding:8px}
.daraz-scroll{display:flex;gap:8px;overflow-x:auto}
.daraz-item{min-width:110px;background:#f5f5f5;border-radius:8px;padding:6px;text-align:center}
.daraz-item img{width:100%;height:75px;border-radius:6px;object-fit:cover}
.buy{display:block;background:#f57224;color:#fff;padding:4px;border-radius:12px;text-decoration:none;font-size:10px;margin-top:4px}
.social-box{background:linear-gradient(135deg,#1a1a1a,#000);padding:12px;border-radius:12px;margin:8px;border:1px solid #333}
.install-banner{display:none;background:linear-gradient(135deg,#f57224,#ff0000);padding:10px;position:fixed;top:0;left:0;right:0;z-index:9999}
#installBtn{display:none;position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,#f57224,#ff0000);color:#fff;border:none;padding:14px 24px;border-radius:30px;font-weight:bold;z-index:9998;box-shadow:0 6px 20px rgba(245,114,36,0.6);animation:jump 2s infinite}
@keyframes jump{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(-5px)}}
</style>
</head>
<body>

<!-- Header -->
<div class="header">
<span style="font-weight:bold">🕋 নামাজী বন্ধু</span>
<div style="display:flex;gap:5px">
<a href="https://www.youtube.com/@MasrafiIslamBD" target="_blank" style="background:#ff0000;color:#fff;padding:5px 8px;border-radius:15px;text-decoration:none;font-size:9px">🔴 YouTube</a>
<a href="https://www.facebook.com/search/pages/?q=নামাজী%20বন্ধু" target="_blank" style="background:#1877f2;color:#fff;padding:5px 8px;border-radius:15px;text-decoration:none;font-size:9px">📘 FB Page</a>
</div>
</div>

<!-- Running Banner -->
<div class="scroll-banner"><div class="scroll-text">🌍 এখানে সারা পৃথিবীর ভিডিও দেখতে পারবেন! 🇸🇦 Saudi | 🇦🇪 Dubai | 🇧🇩 Bangladesh | 🇬🇧 UK | 🇺🇸 USA | 🇹🇷 Turkey | 🇲🇾 Malaysia | 🇮🇩 Indonesia | 🇶🇦 Qatar | 🔥 World Viral 500+ - সব দেশের Video এক জায়গায়! 📱 নামাজী বন্ধু App Install করুন! 🕋</div></div>

<!-- Install Banner -->
<div id="installBanner" class="install-banner">
<div style="display:flex;justify-content:space-between;align-items:center">
<div><b style="color:#fff;font-size:12px">📲 App Install করুন!</b><br><span style="color:#fff;font-size:9px">Home Screen এ Add করুন</span></div>
<div style="display:flex;gap:4px"><button onclick="installApp()" style="background:#fff;color:#f57224;border:none;padding:8px 14px;border-radius:20px;font-weight:bold">📥 Install</button><button onclick="document.getElementById('installBanner').style.display='none'" style="background:rgba(0,0,0,0.3);color:#fff;border:none;padding:6px 10px;border-radius:12px">✕</button></div>
</div>
</div>

<!-- World Notice -->
<div class="world-notice">
<p style="margin:0;color:#f57224;font-weight:bold;font-size:14px">🌍 সারা পৃথিবীর ভিডিও এখানে! 🌍</p>
<p style="margin:4px 0;color:#fff;font-size:11px">Saudi | Dubai | BD | UK | USA | Turkey | Malaysia | Qatar - সব দেশের Video</p>
<div style="display:flex;gap:4px;flex-wrap:wrap;justify-content:center;margin-top:6px">
<span style="background:#f57224;color:#fff;padding:3px 8px;border-radius:12px;font-size:9px">🇸🇦 Saudi 50+</span>
<span style="background:#ff0000;color:#fff;padding:3px 8px;border-radius:12px;font-size:9px">🇦🇪 Dubai 50+</span>
<span style="background:#00c853;color:#fff;padding:3px 8px;border-radius:12px;font-size:9px">🇧🇩 BD 100+</span>
<span style="background:#222;color:#fff;padding:3px 8px;border-radius:12px;font-size:9px">🌍 World 500+</span>
</div>
</div>

<!-- Search -->
<div class="search-box">
<input id="searchInput" placeholder="🔍 যেটা খুঁজবেন লিখুন - waz, gan, Saudi, Dubai, funny...">
<button onclick="clearSearch()" style="background:#444;color:#fff;border:none;padding:8px 12px;border-radius:15px">❌</button>
</div>
<div class="country-bar">
<button id="btn-all" class="country-btn active" onclick="filterByCountry('all')">🌍 সব</button>
<button id="btn-sa" class="country-btn" onclick="filterByCountry('sa')">🇸🇦 Saudi</button>
<button id="btn-ae" class="country-btn" onclick="filterByCountry('ae')">🇦🇪 Dubai</button>
<button id="btn-bd" class="country-btn" onclick="filterByCountry('bd')">🇧🇩 BD</button>
<button id="btn-gb" class="country-btn" onclick="filterByCountry('gb')">🇬🇧 UK</button>
<button id="btn-us" class="country-btn" onclick="filterByCountry('us')">🇺🇸 USA</button>
<button id="btn-tr" class="country-btn" onclick="filterByCountry('tr')">🇹🇷 Turkey</button>
</div>

<div id="searchInfo" style="display:none;background:#222;padding:8px;border-radius:8px;margin:8px;text-align:center;border:1px solid #f57224"></div>
<div id="feed" class="feed">Loading...</div>

<button id="installBtn" onclick="installApp()">📲 App Install করুন - 1 Click এ</button>

<script>
// ✅ LINKS
const MY_FB = "https://www.facebook.com/search/pages/?q=নামাজী%20বন্ধু";
const MY_YT = "https://www.youtube.com/@MasrafiIslamBD";
const DARAZ = "https://s.daraz.com.bd/s.YeIxh?cc";

// ✅ WORLD VIDEOS - 500+ - Sample - আপনার আগের worldVideos Array এখানে বসবে
let worldVideos = [
{title:"Saudi Makkah Live - Beautiful Quran", user:"Saudi TV", country:"sa", countryName:"Saudi", category:["saudi","islam","quran"], views:"1.2M"},
{title:"Dubai Burj Khalifa Viral Video", user:"Dubai Life", country:"ae", countryName:"Dubai", category:["dubai","viral"], views:"500K"},
{title:"Bangladesh Waz - Mizanur Rahman", user:"Islamic BD", country:"bd", countryName:"BD", category:["bd","islam","waz"], views:"2M"},
{title:"Turkey Islamic History", user:"Turkey TV", country:"tr", countryName:"Turkey", category:["turkey","islam"], views:"800K"},
{title:"Funny Video World Viral", user:"Funny World", country:"us", countryName:"USA", category:["funny","viral"], views:"5M"},
];

let loadedCount = 6;
let searchText = "";
let selectedCountry = "all";
let deferredPrompt = null;

function getFiltered(){
let all = [...worldVideos];
let saved = JSON.parse(localStorage.getItem('allVideos')||'[]');
all = [...saved, ...all];
let f = all;
if(searchText){
f = f.filter(v=>{
let t=(v.title||'').toLowerCase(), u=(v.user||'').toLowerCase(), c=(v.category||[]).join(' ').toLowerCase(), co=(v.country||'').toLowerCase();
return t.includes(searchText)||u.includes(searchText)||c.includes(searchText)||co.includes(searchText);
});
}
if(selectedCountry!=='all'){
f = f.filter(v=> v.country===selectedCountry || v.category.includes(selectedCountry));
}
return f;
}

function socialHtml(){
return `<div class="social-box"><div style="text-align:center;margin-bottom:8px"><b style="color:#fff;font-size:13px">🕋 নামাজী বন্ধু - Follow করুন</b></div><div style="display:flex;gap:6px"><a href="${MY_YT}" target="_blank" onclick="adClick()" style="flex:1;background:#ff0000;color:#fff;padding:10px;border-radius:20px;text-decoration:none;font-weight:bold;font-size:11px;text-align:center">🔴 YouTube<br><span style="font-size:8px">@MasrafiIslamBD</span></a><a href="${MY_FB}" target="_blank" onclick="adClick()" style="flex:1;background:#1877f2;color:#fff;padding:10px;border-radius:20px;text-decoration:none;font-weight:bold;font-size:11px;text-align:center">📘 Facebook<br><span style="font-size:8px">নামাজী বন্ধু</span></a></div></div>`;
}

function darazHtml(){
return `<div style="display:flex;justify-content:space-between;margin:8px 0 6px 0"><b style="color:#f57224;font-size:11px">🛒 Daraz Product</b></div><div class="daraz-scroll"><div class="daraz-item"><img src="https://via.placeholder.com/110x75/f57224/fff?text=Shirt"><p style="font-size:10px">Shirt ৳299</p><a href="${DARAZ}" target="_blank" class="buy" onclick="adClick()">🛒 কিনুন</a></div><div class="daraz-item"><img src="https://via.placeholder.com/110x75/000/fff?text=Panjabi"><p style="font-size:10px">Panjabi ৳599</p><a href="${DARAZ}" target="_blank" class="buy" onclick="adClick()">🛒 কিনুন</a></div><div class="daraz-item"><img src="https://via.placeholder.com/110x75/1877f2/fff?text=Watch"><p style="font-size:10px">Watch ৳899</p><a href="${DARAZ}" target="_blank" class="buy" onclick="adClick()">🛒 কিনুন</a></div></div>`;
}

function render(){
let list = getFiltered();
let feed = document.getElementById('feed');
let show = list.slice(0,loadedCount);
feed.innerHTML = show.map(v=>`<div class="video-card"><div style="padding:10px"><b style="font-size:13px">${v.title}</b><br><span style="font-size:10px;color:#aaa">👤 ${v.user} | 🌍 ${v.countryName||v.country} | 👁 ${v.views||'1K'}</span></div>${socialHtml()}<div class="daraz-below">${darazHtml()}</div></div>`).join('') + (list.length>loadedCount?`<button onclick="loadedCount+=6;render()" style="width:100%;background:#f57224;color:#fff;border:none;padding:12px;border-radius:20px;font-weight:bold;margin-top:8px">🔽 আরও Video দেখুন - ${list.length-loadedCount} টা বাকি</button>`:'');
}

function filterByCountry(code){
selectedCountry=code; loadedCount=6;
document.querySelectorAll('.country-btn').forEach(b=>b.classList.remove('active'));
document.getElementById('btn-'+code).classList.add('active');
render();
}

function clearSearch(){document.getElementById('searchInput').value=''; searchText=''; document.getElementById('searchInfo').style.display='none'; render();}

function adClick(){ window.open('https://demper.org/4/e8283733c30352cb0223ec5729c1cb88','_blank'); }

document.getElementById('searchInput').addEventListener('input',(e)=>{
searchText=e.target.value.toLowerCase().trim(); loadedCount=6;
let info=document.getElementById('searchInfo');
if(searchText){info.innerHTML=`🔍 "<b style="color:#f57224">${searchText}</b>" - ${getFiltered().length} টা Video!`; info.style.display='block';}else info.style.display='none';
render();
});

// Install
window.addEventListener('beforeinstallprompt',(e)=>{e.preventDefault(); deferredPrompt=e; document.getElementById('installBanner').style.display='block'; document.getElementById('installBtn').style.display='block';});
function installApp(){ if(deferredPrompt){deferredPrompt.prompt(); deferredPrompt.userChoice.then(c=>{ if(c.outcome==='accepted'){alert('✅ App Install হলো!'); document.getElementById('installBanner').style.display='none'; document.getElementById('installBtn').style.display='none';} deferredPrompt=null;});}else alert('📱 Menu (⋮) -> Add to Home Screen এ Click করুন!');}
setTimeout(()=>{if(!deferredPrompt) document.getElementById('installBtn').style.display='block';},5000);

render();
</script>
</body>
</html>
