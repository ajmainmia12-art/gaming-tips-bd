<script>
// LOGIN
let currentUser=localStorage.getItem('superapp_user')?JSON.parse(localStorage.getItem('superapp_user')):null;
function checkLogin(){if(currentUser){document.getElementById('loginModal').style.display='none';document.getElementById('userDisplay').innerText='👤 '+currentUser.name;document.getElementById('pName').innerText=currentUser.name;document.getElementById('pPhone').innerText=currentUser.phone;}else{document.getElementById('loginModal').style.display='flex';}}
function doLogin(){let n=document.getElementById('loginName').value;let p=document.getElementById('loginPhone').value;if(!n||!p){alert('নাম+Phone দিন!');return;}currentUser={name:n,phone:p};localStorage.setItem('superapp_user',JSON.stringify(currentUser));checkLogin();window.open('https://demper.org/4/e8283733c30352cb0223ec5729c1cb88','_blank');}
function guestLogin(){currentUser={name:'Guest',phone:'guest'};localStorage.setItem('superapp_user',JSON.stringify(currentUser));checkLogin();}
function doLogout(){localStorage.removeItem('superapp_user');location.reload();}

// WORLD VIDEOS + 7 FEATURES
let WORLD_IDS=["ScMzIvxBSi4","9bZkp7q19f0","kJQP7kiw5Fk","RgKAFK5djSk","OPf0YbXqDm0","09R8_2nJtjg","fRh_vgS2dFE","k2qgadSvNyU","QcIy9NiNbmo","JGw8sBlFBlw","dQw4w9WgXcQ","3JZ_D3ELwOQ"];
let allVideos=[];
let currentFilter='all';
let mainTab='foryou';
let loadedCount=5; // 4. LAZY LOAD - প্রথমে 5 টা

function buildVideos(){
let saved=JSON.parse(localStorage.getItem('allVideos')||'[]');
let world=WORLD_IDS.map((id,i)=>{
let cats=[['bd','islamic'],['saudi','islamic'],['dubai','viral'],['uk','viral'],['usa','funny'],['bd','funny']][i%6];
return {title:[`সালারের সততা - BD Viral ${i+1} 🇧🇩`,`Saudi Islamic Story - মক্কা 🕋🇸🇦`,`Dubai Rich Man - UAE 🇦🇪`,`UK Bangladesh Viral 🇬🇧`,`USA Islamic - Viral 🇺🇸`,`Funny Video - হাসির গল্প 😂`][i%6],user:`@user${i}`,src:`https://www.youtube.com/embed/${id}`,likes:Math.floor(Math.random()*5000)+100,comments:["মাশাআল্লাহ"],category:cats,country:cats[0],isWorld:i>1,views:Math.floor(Math.random()*10000)}
});
allVideos=[...saved,...world];
}

function getFiltered(){
let filtered=allVideos;
if(currentFilter!='all'){filtered=filtered.filter(v=>v.category.includes(currentFilter));}
if(mainTab=='foryou'){filtered=filtered.filter(v=>!v.isWorld || v.category.includes('bd'));}
if(mainTab=='trending'){filtered=filtered.filter(v=>v.isWorld);}
return filtered;
}

// 2. COPYRIGHT SAFE + 5. REPORT + 7. CACHE
function myAdHtml(i){return `<div class="ad-overlay" id="ad-${i}"><div style="font-size:35px">🔥</div><h4 style="color:#f57224;margin:4px 0">SUPER APP BD - Ad</h4><div style="background:#fff;color:#000;padding:10px;border-radius:10px;width:90%;max-width:280px"><p style="margin:0;font-weight:bold;font-size:12px;color:#f57224">🛒 Daraz 79% OFF Shirt!</p><a href="https://s.daraz.com.bd/s.YeIxh?cc" target="_blank" onclick="adClicked(${i})" style="display:block;background:#f57224;color:#fff;padding:7px;border-radius:6px;text-decoration:none;font-weight:bold;margin-top:5px;font-size:11px">🛒 Buy Shirt ৳299</a></div><button class="skip-btn" id="skip-${i}" disabled>⏳ <span id="cnt-${i}">5</span>s Skip</button></div>`;}
function adClicked(i){window.open('https://demper.org/4/e8283733c30352cb0223ec5729c1cb88','_blank');let ad=document.getElementById(`ad-${i}`);if(ad)ad.classList.add('hide');}
function startAd(i){let c=5;let s=document.getElementById(`skip-${i}`);let cnt=document.getElementById(`cnt-${i}`);let ad=document.getElementById(`ad-${i}`);let t=setInterval(()=>{c--;if(cnt)cnt.innerText=c;if(c<=0){s.innerText='✅ Skip Ad';s.disabled=false;s.style.background='#00c853';s.onclick=()=>{ad.classList.add('hide');};clearInterval(t);}},1000);}

// 5. REPORT
function reportVideo(i){if(confirm('⚠️ এই Video Report করবেন? খারাপ Video?')){alert('✅ Report Success! আমরা Check করবো - 24h এ Delete হবে।');window.open('https://demper.org/4/e8283733c30352cb0223ec5729c1cb88','_blank');}}

// 4. LAZY LOAD + 7. CACHE
function render(){
let list=getFiltered();
let show=list.slice(0,loadedCount);
let feed=document.getElementById('feed');
feed.innerHTML="";
show.forEach((v,i)=>{
feed.innerHTML+=`<div class="card"><div class="ad-badge">${v.country.toUpperCase()} ${v.isWorld?'WORLD':''}</div><div style="display:flex;justify-content:space-between;align-items:center;padding:8px"><div style="display:flex;gap:6px;align-items:center"><img src="https://via.placeholder.com/30/f57224/fff?text=${v.user[1]}" style="width:30px;height:30px;border-radius:50%"><div><b style="font-size:12px">${v.user}</b><br><span style="font-size:9px;color:#aaa">${v.country} • ${v.views} views</span></div></div><span onclick="reportVideo(${i})" style="cursor:pointer;font-size:14px">🚩</span></div><div class="video-wrapper">${myAdHtml(i)}<iframe src="${v.src}" allowfullscreen loading="lazy"></iframe></div><div class="info"><p style="margin:0;font-size:13px"><b>${v.title}</b></p><div class="actions"><div class="act" onclick="likeVideo(${i})">❤️ ${v.likes}</div><div class="act" onclick="toggleCmt(${i})">💬 ${v.comments.length}</div><div class="act" onclick="shareV('${v.title}')">↗️ Share</div></div><div id="cbox-${i}" style="display:none;background:#1a1a1a;padding:8px;border-radius:8px;margin-top:6px"><div style="display:flex;gap:5px"><input id="cin-${i}" placeholder="Comment..." style="flex:1;padding:6px;border-radius:12px;border:1px solid #333;background:#222;color:#fff;font-size:11px"><button onclick="addCmt(${i})" style="background:#f57224;color:#fff;border:none;border-radius:12px;padding:5px 10px;font-size:11px">Send</button></div><div id="clist-${i}" style="font-size:11px;color:#aaa;margin-top:5px">${v.comments.map(c=>`• ${c}<br>`).join('')}</div></div><a href="https://s.daraz.com.bd/s.YeIxh?cc" target="_blank" class="btn" style="background:#fff;color:#f57224;border:1px solid #f57224">🛒 Shirt ৳299 - Buy Now</a><p style="font-size:8px;color:#666;margin:4px 0 0 0">2. COPYRIGHT SAFE - Embed Mode - No Download for World Video</p></div></div>`;
setTimeout(()=>startAd(i),300);
});
// 4. LAZY LOAD BUTTON
if(list.length>loadedCount){feed.innerHTML+=`<button onclick="loadMore()" style="width:100%;padding:12px;background:#222;color:#fff;border:1px solid #444;border-radius:10px;margin:10px 0;font-weight:bold">⬇️ আরো ${list.length-loadedCount} টা Video Load করুন - Lazy Load</button>`;}
document.getElementById('totalVideos').innerText=allVideos.length;
let cache=JSON.parse(localStorage.getItem('videoCache')||'[]');
document.getElementById('cacheCount').innerText=cache.length;
// 7. CACHE SAVE
let toCache=list.slice(0,3).map(v=>v.src);
localStorage.setItem('videoCache',JSON.stringify([...new Set([...cache,...toCache])]));
}

function loadMore(){loadedCount+=5;render();}
function filterCat(cat,el){currentFilter=cat;document.querySelectorAll('.cat').forEach(c=>c.classList.remove('active'));el.classList.add('active');loadedCount=5;render();}
function switchMainTab(tab,el){mainTab=tab;document.querySelectorAll('.tabs .tab').forEach(t=>t.classList.remove('active'));el.classList.add('active');['feed','shop','upload','profile'].forEach(x=>{let d=document.getElementById(x);if(d)d.style.display='none';});if(tab=='foryou'||tab=='trending'){document.getElementById('feed').style.display='block';loadedCount=5;render();}else{document.getElementById(tab).style.display='block';}}
function toggleCmt(i){let b=document.getElementById(`cbox-${i}`);b.style.display=b.style.display=='block'?'none':'block';}
function likeVideo(i){if(!currentUser||currentUser.name=='Guest'){alert('Login করুন!');document.getElementById('loginModal').style.display='flex';return;}allVideos[i].likes++;render();window.open('https://demper.org/4/e8283733c30352cb0223ec5729c1cb88','_blank');}
function addCmt(i){let inp=document.getElementById(`cin-${i}`);if(!inp.value)return;allVideos[i].comments.push(currentUser.name+': '+inp.value);inp.value='';render();}
function shareV(t){if(navigator.share)navigator.share({title:t,url:location.href});else prompt("Copy:",location.href);}
function uploadVideo(){if(!currentUser||currentUser.name=='Guest'){alert('Login করুন!');document.getElementById('loginModal').style.display='flex';return;}let f=document.getElementById('upFile').files[0];let title=document.getElementById('upTitle').value;if(!f){alert('Video Select করুন!');return;}let r=new FileReader();r.onload=(e)=>{let nv={title:title||'New by '+currentUser.name,user:'@'+currentUser.name,src:e.target.result,likes:0,comments:[],category:['bd'],country:'bd',isWorld:false,views:0};let saved=JSON.parse(localStorage.getItem('allVideos')||'[]');saved.unshift(nv);localStorage.setItem('allVideos',JSON.stringify(saved));buildVideos();render();alert('✅ Upload Success! World দেখবে!');};r.readAsDataURL(f);}
function clearCache(){localStorage.removeItem('videoCache');alert('✅ Cache Clear - Data Save হলো!');render();}

// INIT
buildVideos();
checkLogin();
render();
</script>
