<!DOCTYPE html><html lang="bn"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>SUPER APP BD - Bangla Fixed</title><style>body{margin:0;background:#000;color:#fff;font-family:system-ui}.h{background:#ff6f00;padding:10px 14px;display:flex;justify-content:space-between}.s{padding:10px;background:#111;display:flex;gap:8px}.s input{flex:1;background:#000;color:#fff;border:2px solid #ff6f00;padding:12px 16px;border-radius:25px;outline:none}.s button{background:#ff6f00;color:#fff;border:none;padding:12px 20px;border-radius:25px;font-weight:800}.card{background:#111;margin:10px;border-radius:12px;overflow:hidden;border:1px solid #222}.card img{width:100%;height:180px;object-fit:cover}</style></head><body>
<div class="h"><b>🔥 SUPER APP BD</b><span>👤 Masrafi</span></div>
<div class="s"><input id="q" value="বাংলা নাটক" placeholder="নাটক লিখুন..."><button onclick="searchNow()">Search</button></div>
<div id="feed"></div>
<div id="player" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:#000;z-index:999;flex-direction:column"><div style="padding:12px;background:#111;display:flex;justify-content:space-between"><b>▶ Playing</b><button onclick="document.getElementById('player').style.display='none';document.getElementById('frame').src=''" style="background:#333;color:#fff;border:none;width:32px;height:32px;border-radius:50%">X</button></div><iframe id="frame" style="flex:1;border:none" allowfullscreen></iframe></div>
<script>
async function searchNow(){
let q=document.getElementById('q').value.trim()||'বাংলা নাটক';
let f=document.getElementById('feed');
f.innerHTML='<div style="text-align:center;padding:30px;color:#ff6f00">🔍 "'+q+'" - বাংলা নাটক খুঁজছি...</div>';
// বাংলা নাটক Fix - Query এ Bangla যোগ
let searchQ=q;
if(!q.toLowerCase().includes('bangla') && !q.includes('বাংলা') && q.length<20){
searchQ=q+' Bangla Natok 2024';
}
try{
let r=await fetch('https://pipedapi.kavin.rocks/search?q='+encodeURIComponent(searchQ)+'&filter=videos');
let d=await r.json();
let items=(d.items||d).slice(0,15);
f.innerHTML=items.map(v=>{
let id=(v.url||'').split('v=')[1]||v.url?.split('/').pop()||v.id||'';
if(!id)return '';
return `<div class="card" onclick="play('${id}')"><img src="${v.thumbnail||'https://img.youtube.com/vi/'+id+'/mqdefault.jpg'}" onerror="this.src='https://img.youtube.com/vi/${id}/mqdefault.jpg'"><div style="padding:10px"><b>${v.title}</b><br><span style="color:#ff6f00;font-size:11px">🎬 ${v.uploaderName||'Bangla Natok'}</span><br><button style="margin-top:6px;width:100%;background:#ff6f00;color:#fff;border:none;padding:10px;border-radius:20px">▶ Play - বাংলা নাটক</button></div></div>`;
}).join('');
if(!f.innerHTML)throw 'empty';
}catch(e){
let backup=[
{id:'2OEL4P1Rz04',t:'বাংলা নাটক - Eid Natok 2024 - Afran Nisho'},
{id:'3tmd-ClpJxA',t:'Mehazabien Chowdhury Natok 2024 - New'},
{id:'YQHsXMglC9A',t:'Tawsif Mahbub Natok - Bangla Natok 2024'},
{id:'9bZkp7q19f0',t:'Bangla Natok 2024 - Full Drama'},
{id:'RgKAFK5djSk',t:'Waz Bangla - Natok Like Story'}
];
f.innerHTML=backup.map(v=>`<div class="card" onclick="play('${v.id}')"><img src="https://img.youtube.com/vi/${v.id}/mqdefault.jpg"><div style="padding:10px"><b>${q} - ${v.t}</b><br><span style="color:#ff6f00;font-size:11px">🎬 Bangla Natok 2024</span><br><button style="width:100%;margin-top:6px;background:#ff6f00;color:#fff;border:none;padding:10px;border-radius:20px">▶ Play</button></div></div>`).join('');
}
}
function play(id){document.getElementById('frame').src='https://www.youtube.com/embed/'+id+'?autoplay=1';document.getElementById('player').style.display='flex';}
searchNow();
</script></body></html>
